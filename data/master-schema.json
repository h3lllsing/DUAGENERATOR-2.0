{
  "schemaVersion": 2,
  "description": "UNIFIED MASTER SCHEMA — single source of truth for every importable item type (pattern, plugin, theme, typography, motion, audio). The VFX pattern + overrides sections are byte-identical to the legacy data/vfx-schema.json (8 kinds, 20 override keys). Regenerate all twins with: npm run gen:master-schema (remotion/).",
  "hexColorPattern": "^#[0-9A-Fa-f]{3,8}$",
  "pattern": {
    "zonesExclusive": ["top", "frame"],
    "fields": {
      "tileSize": { "type": "int", "min": 16, "max": 256, "def": 150 },
      "strokeWidth": { "type": "float", "min": 0.25, "max": 8, "def": 1.5 },
      "alpha": { "type": "float", "min": 0.05, "max": 1, "def": 0.5 },
      "opacity": { "type": "float", "min": 0.05, "max": 1, "def": 0.5 },
      "bandSize": { "type": "int", "min": 24, "max": 160, "def": 64 },
      "breathFrames": { "type": "int", "min": 0, "max": 1000, "def": 0 },
      "breathAmpl": { "type": "float", "min": 0, "max": 0.25, "def": 0 },
      "seedSalt": { "type": "int", "min": 0, "max": 999, "def": 0 }
    },
    "enums": {
      "kind": ["girih-band", "girih-corners", "arabesque-strip", "arabesque-corners", "bead-band", "starfield-dots", "meander-band", "geometric-rosette"],
      "colorToken": ["accent", "glowColor", "particleColor", "solid"],
      "zones": ["top", "bottom", "frame", "corners"]
    }
  },
  "overrides": [
    { "key": "cornerInset", "type": "number", "min": 12, "max": 140, "def": 52 },
    { "key": "cornerSize", "type": "number", "min": 32, "max": 160, "def": 76 },
    { "key": "cornerOpacity", "type": "number", "min": 0.2, "max": 2, "def": 1 },
    { "key": "frameEnabled", "type": "boolean" },
    { "key": "frameOpacity1", "type": "number", "min": 0, "max": 1, "def": 0.3 },
    { "key": "frameOpacity2", "type": "number", "min": 0, "max": 1, "def": 0.16 },
    { "key": "ornamentScale", "type": "number", "min": 0.5, "max": 2, "def": 1 },
    { "key": "ornamentSwayDeg", "type": "number", "min": 0, "max": 30, "def": 8 },
    { "key": "raysOpacity", "type": "number", "min": 0, "max": 1.5, "def": 0.6 },
    { "key": "orbsOpacity", "type": "number", "min": 0, "max": 2, "def": 1 },
    { "key": "particlesScale", "type": "number", "min": 0.3, "max": 3, "def": 1 },
    { "key": "grainOpacityDark", "type": "number", "min": 0, "max": 0.25, "def": 0.06 },
    { "key": "grainOpacityPaper", "type": "number", "min": 0, "max": 0.25, "def": 0.08 },
    { "key": "vignetteScale", "type": "number", "min": 0.5, "max": 1.6, "def": 1 },
    { "key": "bokehCount", "type": "number", "min": 0, "max": 80, "def": 0 },
    { "key": "bokehOpacity", "type": "number", "min": 0, "max": 1, "def": 0.5 },
    { "key": "chromaticAberration", "type": "number", "min": 0, "max": 6, "def": 0 },
    { "key": "shimmerStrength", "type": "number", "min": 0, "max": 1, "def": 0.5 },
    { "key": "noiseVeilOpacity", "type": "number", "min": 0, "max": 1, "def": 0 },
    { "key": "raysAngleDeg", "type": "number", "min": -30, "max": 60, "def": 0 }
  ],
  "plugin": {
    "matchWildcard": "*",
    "matchPattern": "^[a-z0-9_-]{1,80}$",
    "idPattern": "^[A-Za-z0-9_-]{1,48}$"
  },
  "theme": {
    "enums": {
      "id": ["dark", "mosque", "sunset", "manuscript", "emerald", "ocean", "desert", "royal", "ramadan", "eid", "qadr"],
      "decor": ["stars", "mosque", "sun", "paper", "pattern", "waves", "dunes", "royal", "lanterns", "festive", "qadr"]
    },
    "grade": {
      "brightness": { "type": "number", "min": 0.7, "max": 1.5, "def": 1 },
      "contrast": { "type": "number", "min": 0.7, "max": 1.6, "def": 1 },
      "saturate": { "type": "number", "min": 0.5, "max": 1.8, "def": 1 }
    }
  },
  "typography": {
    "enums": {
      "family": ["amiri-quran", "noto-nastaliq-urdu", "scheherazade-new"],
      "role": ["arabic", "urdu", "ui", "emoji"]
    },
    "sizes": {
      "arabicBase": { "type": "int", "min": 44, "max": 160, "def": 104 },
      "urduBase": { "type": "int", "min": 24, "max": 90, "def": 50 },
      "arabicMin": { "type": "int", "min": 20, "max": 90, "def": 58 },
      "urduMin": { "type": "int", "min": 14, "max": 60, "def": 32 },
      "lineHeightAr": { "type": "float", "min": 1.2, "max": 3, "def": 1.95 },
      "lineHeightUr": { "type": "float", "min": 1.2, "max": 3, "def": 2.3 }
    }
  },
  "motion": {
    "enums": {
      "frame": ["classic", "arch", "deco", "rosette"],
      "textFx": ["glide", "fade", "none", "typewriter", "popwave"],
      "motif": ["none", "tasbih", "kaaba", "rehal", "star8"],
      "gradeFx": ["auto", "warmgold", "coolnight", "sepia", "dreamy"],
      "camera": ["static", "zoomin", "panx", "kenburns"],
      "introFx": ["classic", "crescentfade", "patternwipe"],
      "ornament": ["starcrescent", "lanternjhumka", "medallion", "geostar"],
      "borderFx": ["none", "clouds", "birds", "flags", "wind"],
      "skyFx": ["none", "rain", "storm", "snow", "fog", "smoke", "fireflies", "petals"],
      "artFx": ["none", "rosette", "sitare", "vines", "lanterns", "caravan", "palms"]
    }
  },
  "audio": {
    "enums": {
      "voiceArabic": ["ar-SA-HamedNeural", "ar-SA-ZariyahNeural"],
      "voiceUrdu": ["ur-PK-AsadNeural", "ur-PK-UzmaNeural"],
      "sfxSet": ["default"]
    }
  }
}