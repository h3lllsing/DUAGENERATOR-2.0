{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx", "-y",
        "@modelcontextprotocol/server-filesystem",
        "H:\\DuaVideoGenerator"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "security-tools": {
      "type": "local",
      "command": [
        "python",
        "H:\\MCP\\server\\server.py"
      ],
      "env": {
        "WORKSPACE_ROOT": "H:\\DuaVideoGenerator",
        "PYTHONUNBUFFERED": "1"
      },
      "enabled": true
    }
  }
}
